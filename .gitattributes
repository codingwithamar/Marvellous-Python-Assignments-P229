# Automatically detect text files
* text=auto

# Source code files
*.py      text eol=lf
*.c       text eol=lf
*.cpp     text eol=lf
*.h       text eol=lf
*.java    text eol=lf
*.js      text eol=lf
*.ts      text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.json    text eol=lf
*.xml     text eol=lf
*.md      text eol=lf
*.sh      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf

# Windows scripts
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf